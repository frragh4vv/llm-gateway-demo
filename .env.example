# Copy to .env (scripts/run_local.py does this for you and fills random secrets).
# Never commit .env. Never put provider keys in config files.

# Admin key for the gateway. Only the ops team has this. Must start with "sk-".
LITELLM_MASTER_KEY=sk-change-me
# Encrypts credentials LiteLLM stores in Postgres. Set once; do not change after first run.
LITELLM_SALT_KEY=change-me-too
# Use the bundled model cost map instead of fetching it from GitHub at startup.
LITELLM_LOCAL_MODEL_COST_MAP=True

# Postgres. docker compose overrides this; run_local.py starts an embedded Postgres and overrides it too.
POSTGRES_PASSWORD=change-me-db
DATABASE_URL=postgresql://litellm:change-me-db@localhost:5432/litellm

# Mock providers (offline demo).
MOCK_OPENAI_BASE=http://localhost:8001/openai/v1
MOCK_ANTHROPIC_BASE=http://localhost:8001/anthropic/v1
MOCK_PROVIDER_KEY=mock-not-a-real-key
# Comma list of providers that start "down": openai, anthropic
MOCK_FAIL_PROVIDERS=

# Request log written by gateway/request_logger.py, read by the dashboard.
REQUEST_LOG_PATH=logs/requests.jsonl

# Optional free-tier providers (models gemini-flash, groq-llama, mistral-7b; run demo.py --real).
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Optional paid providers (uncomment the matching models in gateway/config*.yaml).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
